# API
API_PORT=8000

# Database (read by app/core/config.py)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=multi_rag
DB_USER=postgres
DB_PASS=change-me

# MinIO (MINIO_SECRET_KEY must be at least 8 characters)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-please
MINIO_SECURE=False
MINIO_BUCKET=documents

# Models
# DEVICE: auto | cuda | mps | cpu | mlx
#   auto -> cuda if available, else mps (Apple GPU), else cpu
#   mlx  -> Apple Silicon only, uses mlx-lm / mlx-vlm instead of PyTorch
DEVICE=auto
# QUANT_BITS: empty = full precision, 4 or 8 (cuda: bitsandbytes, mps/cpu: quanto; ignored on mlx)
QUANT_BITS=
LLM_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
VLM_MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct
EMBEDDING_MODEL_ID=BAAI/bge-m3